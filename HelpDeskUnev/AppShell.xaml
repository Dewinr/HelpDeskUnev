<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="HelpDeskUnev.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:HelpDeskUnev.Views"
    Title="HelpDeskUnev">

    <TabBar>
        <Tab Title="Clientes">
            <ShellContent ContentTemplate="{DataTemplate views:ClientePage}" />
        </Tab>
        <Tab Title="Productos">
            <ShellContent ContentTemplate="{DataTemplate views:ProductoPage}" />
        </Tab>
        <Tab Title="Ticketera">
            <ShellContent ContentTemplate="{DataTemplate views:TicketPage}" />
        </Tab>
    </TabBar>

</Shell>