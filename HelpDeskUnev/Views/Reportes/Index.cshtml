@{
    ViewData["Title"] = "Reportes y Estadísticas - Help Desk";
}

<div class="container mt-4">
    <div class="mb-4">
        <h2 class="fw-bold text-dark"><i class="bi bi-file-earmark-bar-graph-fill text-danger me-2"></i>Reportes Institucionales</h2>
        <p class="text-muted mb-0">Resumen y métricas generales del sistema de soporte (Fase 4)</p>
    </div>

    <div class="row g-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 bg-primary text-white p-3">
                <h5>Total de Tickets</h5>
                <h3 class="fw-bold">@ViewBag.TotalTickets</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 bg-warning text-dark p-3">
                <h5>Tickets Activos</h5>
                <h3 class="fw-bold">@ViewBag.TicketsAbiertos</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 bg-success text-white p-3">
                <h5>Tickets Resueltos</h5>
                <h3 class="fw-bold">@ViewBag.TicketsResueltos</h3>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm rounded-3 bg-dark text-white p-3">
                <h5>Usuarios Registrados</h5>
                <h3 class="fw-bold">@ViewBag.TotalUsuarios</h3>
            </div>
        </div>
    </div>
</div>