@{
    ViewData["Title"] = "Dashboard - Help Desk UNEV";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold" style="color: #003366;">Dashboard General</h2>
            <p class="text-muted mb-0">Resumen operativo del sistema de soporte técnico universitario</p>
        </div>
        <a asp-controller="Ticket" asp-action="Crear" class="btn btn-primary fw-bold" style="background-color: #003366; border-color: #003366;">
            + Nuevo Ticket
        </a>
    </div>

    <!-- Tarjetas Metricas Principales -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm text-white bg-danger h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <h6 class="text-uppercase fw-bold opacity-75 mb-1">Tickets Abiertos</h6>
                        <h2 class="display-6 fw-bold mb-0">@ViewBag.TicketsAbiertos</h2>
                    </div>
                    <div class="fs-1 opacity-50">
                        <i class="bi bi-exclamation-circle-fill"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm text-dark bg-warning h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <h6 class="text-uppercase fw-bold opacity-75 mb-1">En Proceso</h6>
                        <h2 class="display-6 fw-bold mb-0">@ViewBag.TicketsEnProceso</h2>
                    </div>
                    <div class="fs-1 opacity-50">
                        <i class="bi bi-gear-fill"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm text-white bg-success h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <h6 class="text-uppercase fw-bold opacity-75 mb-1">Resueltos</h6>
                        <h2 class="display-6 fw-bold mb-0">@ViewBag.TicketsResueltos</h2>
                    </div>
                    <div class="fs-1 opacity-50">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm text-white bg-info h-100">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div>
                        <h6 class="text-uppercase fw-bold opacity-75 mb-1">Técnicos Activos</h6>
                        <h2 class="display-6 fw-bold mb-0">@ViewBag.TecnicosDisponibles</h2>
                    </div>
                    <div class="fs-1 opacity-50">
                        <i class="bi bi-person-badge-fill"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Resumen por Categorias -->
    <div class="row">
        <div class="col-lg-12">
            <div class="card shadow-sm border-0">
                <div class="card-header text-white fw-bold py-3" style="background-color: #003366;">
                    Incidencias por Categoría de Servicio
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush">
                        @if (ViewBag.CategoriasResumen != null)
                        {
                            foreach (var item in (Dictionary<string, int>)ViewBag.CategoriasResumen)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                                    <span class="fw-semibold text-secondary">@item.Key</span>
                                    <span class="badge rounded-pill px-3 py-2 fs-6" style="background-color: #003366;">@item.Value tickets</span>
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>