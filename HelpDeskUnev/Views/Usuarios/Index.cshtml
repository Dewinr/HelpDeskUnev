@model IEnumerable<HelpDeskUnev.Models.Usuario>

@{
    ViewData["Title"] = "Gestión de Usuarios - Admin";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark"><i class="bi bi-people-fill text-danger me-2"></i>Control y Gestión de Usuarios</h2>
            <p class="text-muted mb-0">Módulo exclusivo para Administradores (RBAC)</p>
        </div>
        <a asp-action="Crear" class="btn text-white shadow-sm" style="background-color: #54071E;">
            <i class="bi bi-person-plus-fill me-1"></i> Nuevo Usuario
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">Matrícula</th>
                            <th>Nombre Completo</th>
                            <th>Correo</th>
                            <th>Rol / Tipo</th>
                            <th>Estado</th>
                            <th class="text-end pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">@item.Matricula</td>
                                <td>@item.Nombre @item.Apellido</td>
                                <td>@item.Correo</td>
                                <td>
                                    @if (item.Matricula?.Trim().ToLower() == "admin" || item.Correo?.Trim().ToLower() == "admin@unev.edu.do")
                                    {
                                        <span class="badge bg-danger text-white px-3 py-2">Admin</span>
                                    }
                                    else if (item is HelpDeskUnev.Models.Tecnico || item.GetType().Name.Contains("Tecnico", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-warning text-dark px-3 py-2">Técnico</span>
                                    }
                                    else if (item is HelpDeskUnev.Models.Maestro || item.GetType().Name.Contains("Maestro", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="badge bg-info text-dark px-3 py-2">Maestro</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary text-white px-3 py-2">Cliente</span>
                                    }
                                </td>
                                <td>
                                    @if (item.EsActivo)
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Inactivo</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <form asp-action="CambiarEstado" asp-route-id="@item.IdUsuario" method="post" class="d-inline">
                                        <button type="submit" class="btn btn-sm @(item.EsActivo ? "btn-outline-danger" : "btn-outline-success")">
                                            @(item.EsActivo ? "Desactivar" : "Activar")
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>