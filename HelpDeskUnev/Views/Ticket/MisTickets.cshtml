@model IEnumerable<HelpDeskUnev.Models.Ticket>

@{
    ViewData["Title"] = "Mis Solicitudes de Soporte";
}

<div class="container-fluid mt-4">
    <div class="row mb-4 align-items-center">
        <div class="col-md-6">
            <h2 class="fw-bold">Mis Solicitudes de Soporte</h2>
            <p class="text-muted">Historial y seguimiento de tus incidencias reportadas</p>
        </div>
        <div class="col-md-6 text-end">
            <!-- Botón para abrir el Modal de Crear (Fase 3) -->
            <button type="button" class="btn btn-primary shadow-sm" data-bs-toggle="modal" data-bs-target="#modalCrearTicket">
                <i class="bi bi-plus-circle me-1"></i> + Crear Nuevo Ticket
            </button>
        </div>
    </div>
   
    <!-- Alertas de retroalimentación de Token/Seguridad -->
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card card-institucional shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead style="background-color: #212529; color: #FFFFFF;">
                        <tr>
                            <th class="ps-3">#</th>
                            <th>Título / Asunto</th>
                            <th>Categoría</th>
                            <th>Fecha</th>
                            <th>Estado</th>
                            <th class="text-center pe-3">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-4 text-muted">
                                    No tienes solicitudes registradas actualmente.
                                </td>
                            </tr>
                        }
                        else
                        {
                            int contador = 1;
                            @foreach (var ticket in Model)
                            {
                                <tr>
                                    <td class="ps-3"><strong>@contador</strong></td>
                                    <td>@(ticket.Titulo ?? ticket.Asunto ?? "Sin Título")</td>
                                    <td>@(ticket.Categoria?.NombreCategoria ?? "General")</td>
                                    <td>@ticket.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        @{
                                            string claseBadge = "bg-info text-dark";
                                            string nombreEstado = ticket.Estado?.NombreEstado ?? ticket.Estado?.Nombre ?? "Pendiente";
                                            
                                            if (nombreEstado.Contains("Resuelto", StringComparison.OrdinalIgnoreCase))
                                            {
                                                claseBadge = "bg-success text-white"; // Verde deslumbrante para Resuelto
                                            }
                                            else if (nombreEstado.Contains("Proceso", StringComparison.OrdinalIgnoreCase))
                                            {
                                                claseBadge = "bg-info text-dark"; // Azul cielo para En Proceso
                                            }
                                            else if (nombreEstado.Contains("Pendiente", StringComparison.OrdinalIgnoreCase))
                                            {
                                                claseBadge = "bg-warning text-dark"; // Amarillo para Pendiente
                                            }
                                        }
                                        <span class="badge rounded-pill @claseBadge px-3 py-2 fw-normal">
                                            @nombreEstado
                                        </span>
                                    </td>
                                    <td class="text-center pe-3">
                                        <a asp-action="Detalle" asp-route-id="@ticket.IdTicket" class="btn btn-sm btn-secondary me-1">
                                            Ver
                                        </a>

                                        <!-- Formulario de Eliminación Segura protegida por Token (Fase 4) -->
                                        <form asp-action="EliminarConToken" method="post" class="d-inline" onsubmit="return confirm('¿Confirmar la eliminación del ticket con Token de Seguridad autorizada?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="idTicket" value="@ticket.IdTicket" />
                                            <input type="hidden" name="tokenAutorizacion" value="@ViewBag.ActionToken" />
                                            <button type="submit" class="btn btn-sm btn-danger">
                                                Eliminar
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                                contador++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- VENTANA MODAL DE BOOTSTRAP 5 (FASE 3)      -->
<!-- ========================================== -->
<div class="modal fade" id="modalCrearTicket" tabindex="-1" aria-labelledby="modalCrearTicketLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #54071E; color: #FFFFFF;">
                <h5 class="modal-title" id="modalCrearTicketLabel">Crear Nuevo Ticket</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <!-- Apunta al método POST 'Crear' de tu TicketController -->
            <form asp-action="Crear" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Título del Ticket</label>
                        <input type="text" name="Titulo" class="form-control" placeholder="Ej. Problema con mi cuenta" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Descripción del Inconveniente (Asunto)</label>
                        <textarea name="Asunto" class="form-control" rows="3" placeholder="Detalle su situación aquí..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary" style="background-color: #54071E; border-color: #54071E;">Guardar Ticket</button>
                </div>
            </form>
        </div>
    </div>
</div>