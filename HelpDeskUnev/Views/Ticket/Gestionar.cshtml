@model IEnumerable<HelpDeskUnev.Models.Ticket>

@{
    ViewData["Title"] = "Gestión de Tickets de Soporte";
}

<div class="container-fluid mt-4">
    <div class="row mb-4 align-items-center">
        <div class="col-md-6">
            <h2 class="fw-bold">Gestión General de Tickets</h2>
            <p class="text-muted">Consola de administración y resolución de incidencias (Fase 4 - RBAC)</p>
        </div>
        <div class="col-md-6 text-end">
            <button type="button" class="btn btn-primary shadow-sm me-2" data-bs-toggle="modal" data-bs-target="#modalCrearTicket">
                <i class="bi bi-plus-circle me-1"></i> + Nuevo Ticket
            </button>
            <span class="badge p-2 shadow-sm" style="background-color: #D4AF37; color: #54071E; font-size: 0.9rem;">
                <i class="bi bi-shield-lock-fill me-1"></i> Panel de Control
            </span>
        </div>
    </div>

    <!-- Alertas de respuesta del Token y operaciones -->
    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm mb-3" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card card-institucional shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-striped table-hover align-middle mb-0">
                    <thead style="background-color: #54071E; color: #FFFFFF;">
                        <tr>
                            <th class="ps-3">ID</th>
                            <th>Usuario / Solicitante</th>
                            <th>Título</th>
                            <th>Categoría</th>
                            <th>Prioridad</th>
                            <th>Estado</th>
                            <th>Técnico Asignado</th>
                            <th class="text-center pe-3">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="8" class="text-center py-4 text-muted">
                                    No existen tickets registrados en el sistema.
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var ticket in Model)
                            {
                                <tr>
                                    <td class="ps-3"><strong>#@ticket.IdTicket</strong></td>
                                    <td>@(ticket.Cliente != null ? $"{ticket.Cliente.Nombre} {ticket.Cliente.Apellido}" : "N/A")</td>
                                    <td>@(ticket.Titulo ?? ticket.Asunto ?? "Sin Título")</td>
                                    <td>@(ticket.Categoria?.NombreCategoria ?? "General")</td>
                                    <td>
                                        <span class="badge bg-warning text-dark">
                                            @(ticket.Prioridad?.Nivel ?? "Normal")
                                        </span>
                                    </td>
                                    <td>
                                        @{
                                            string claseBadge = "bg-info text-dark";
                                            string nombreEstado = ticket.Estado?.NombreEstado ?? ticket.Estado?.Nombre ?? "Pendiente";
                                            
                                            if (nombreEstado.Contains("Resuelto", StringComparison.OrdinalIgnoreCase))
                                            {
                                                claseBadge = "bg-success text-white";
                                            }
                                            else if (nombreEstado.Contains("Proceso", StringComparison.OrdinalIgnoreCase))
                                            {
                                                claseBadge = "bg-info text-dark";
                                            }
                                            else if (nombreEstado.Contains("Pendiente", StringComparison.OrdinalIgnoreCase))
                                            {
                                                claseBadge = "bg-warning text-dark";
                                            }
                                        }
                                        <span class="badge rounded-pill @claseBadge px-3 py-2 fw-normal">
                                            @nombreEstado
                                        </span>
                                    </td>
                                    <td>
                                        @(ticket.Tecnico != null ? ticket.Tecnico.Nombre : "Sin Asignar")
                                    </td>
                                    <td class="text-center pe-3">
                                        <a asp-action="Detalle" asp-route-id="@ticket.IdTicket" class="btn btn-sm btn-vino me-1" style="background-color: #54071E; color: white;">
                                            Atender
                                        </a>

                                        <!-- Eliminación protegida por Token de Autorización -->
                                        <form asp-action="EliminarConToken" method="post" class="d-inline" onsubmit="return confirm('¿Confirmar la eliminación del ticket con Token de Seguridad autorizada?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="idTicket" value="@ticket.IdTicket" />
                                            <input type="hidden" name="tokenAutorizacion" value="@ViewBag.ActionToken" />
                                            <button type="submit" class="btn btn-sm btn-danger">
                                                Eliminar
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal para Crear Ticket desde la Consola General -->
<div class="modal fade" id="modalCrearTicket" tabindex="-1" aria-labelledby="modalCrearTicketLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" style="background-color: #54071E; color: #FFFFFF;">
                <h5 class="modal-title" id="modalCrearTicketLabel">Registrar Nuevo Ticket</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Crear" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Título del Ticket</label>
                        <input type="text" name="Titulo" class="form-control" placeholder="Ej. Falla de conexión en Campus" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Descripción del Inconveniente</label>
                        <textarea name="Descripcion" class="form-control" rows="3" placeholder="Detalle la solicitud..." required></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary" style="background-color: #54071E; border-color: #54071E;">Guardar Ticket</button>
                </div>
            </form>
        </div>
    </div>
</div>