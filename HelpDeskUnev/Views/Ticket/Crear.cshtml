@model HelpDeskUnev.Models.Ticket

@{
    ViewData["Title"] = "Crear Nuevo Ticket";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="card shadow border-0 rounded-3">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0 fw-bold"><i class="bi bi-ticket-detailed-fill me-2"></i>Crear Solicitud de Soporte</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Crear" method="post">
                        <div class="mb-3">
                            <label asp-for="Asunto" class="form-label fw-semibold">Asunto / Título</label>
                            <input asp-for="Asunto" class="form-control" placeholder="Ej. Problema con acceso al portal de notas" required />
                            <span asp-validation-for="Asunto" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="IdCategoria" class="form-label fw-semibold">Categoría</label>
                                <select asp-for="IdCategoria" class="form-select" asp-items="ViewBag.Categorias" required>
                                    <option value="">-- Seleccione Categoría --</option>
                                </select>
                                <span asp-validation-for="IdCategoria" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="IdPrioridad" class="form-label fw-semibold">Prioridad</label>
                                <select asp-for="IdPrioridad" class="form-select" asp-items="ViewBag.Prioridades" required>
                                    <option value="">-- Seleccione Prioridad --</option>
                                </select>
                                <span asp-validation-for="IdPrioridad" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Descripcion" class="form-label fw-semibold">Descripción Detallada</label>
                            <textarea asp-for="Descripcion" class="form-control" rows="4" placeholder="Explique su inconveniente lo más detallado posible..." required></textarea>
                            <span asp-validation-for="Descripcion" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                            <a asp-action="MisTickets" class="btn btn-outline-secondary px-4">
                                <i class="bi bi-arrow-left me-1"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-primary px-4">
                                <i class="bi bi-send-fill me-1"></i> Enviar Ticket
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>