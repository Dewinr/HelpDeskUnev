<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HelpDeskUnev.Views.ProductoPage"
             Title="Formulario de Producto">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Label Text="Registro de Producto"
                   FontSize="22"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Entry x:Name="txtNombreProd" Placeholder="Nombre del Producto" />
            <Entry x:Name="txtCategoria" Placeholder="Categoría" />
            <Entry x:Name="txtPrecio" Placeholder="Precio" Keyboard="Numeric" />
            <Entry x:Name="txtStock" Placeholder="Stock / Cantidad" Keyboard="Numeric" />
            <Editor x:Name="txtDescripcion" Placeholder="Descripción" HeightRequest="80" />

            <Button x:Name="btnGuardarProducto"
                    Text="Guardar Producto"
                    BackgroundColor="#28A745"
                    TextColor="White"
                    Margin="0,10,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>