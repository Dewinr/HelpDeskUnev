<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HelpDeskUnev.Views.ClientePage"
             Title="Formulario de Cliente">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">

            <Label Text="Registro de Cliente"
                   FontSize="22"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Entry x:Name="txtNombre" Placeholder="Nombre" />
            <Entry x:Name="txtApellido" Placeholder="Apellido" />
            <Entry x:Name="txtTelefono" Placeholder="Teléfono" Keyboard="Telephone" />
            <Entry x:Name="txtCorreo" Placeholder="Correo Electrónico" Keyboard="Email" />
            <Entry x:Name="txtDireccion" Placeholder="Dirección" />

            <Button x:Name="btnGuardarCliente"
                    Text="Guardar Cliente"
                    BackgroundColor="#007AFF"
                    TextColor="White"
                    Margin="0,10,0,0"
                    Clicked="OnGuardarClienteClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>