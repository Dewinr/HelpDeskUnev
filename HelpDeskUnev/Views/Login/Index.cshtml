@{
    Layout = null;
    ViewData["Title"] = "Portal de Autenticación - UNEV Help Desk";
}<!DOCTYPE html><html lang="es"><head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Portal de Autenticación - Help Desk UNEV</title>
    <!-- Bootstrap CSS e Iconos -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    
    <style>
        :root {
            --color-vino: #54071E;       /* Color Vino Tinto Institucional */
            --color-vino-hover: #3b0414;
            --color-borde: #CFD8DC;
            --color-texto-muted: #607D8B;
        }

        body {
            background-color: var(--color-vino) !important;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        /* Tarjeta compacta centrada */
        .login-card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.35);
            background-color: #FFFFFF;
            max-width: 380px; /* Controla el ancho perfecto */
            width: 100%;
        }

        .input-group-text {
            background-color: transparent;
            border: 1px solid var(--color-borde);
            color: var(--color-texto-muted);
            border-right: none;
            padding-left: 0.9rem;
            padding-right: 0.6rem;
        }

        .form-control {
            border: 1px solid var(--color-borde);
            border-left: none;
            padding: 0.55rem 0.8rem;
            font-size: 0.92rem;
            color: #212529;
        }

        .form-control:focus {
            border-color: var(--color-vino);
            box-shadow: none;
        }

        .btn-institucional {
            background-color: var(--color-vino);
            color: #FFFFFF;
            border: none;
            padding: 0.65rem;
            font-size: 0.95rem;
            font-weight: 700;
            border-radius: 8px;
            transition: all 0.3s ease;
        }

        .btn-institucional:hover {
            background-color: var(--color-vino-hover);
            color: #FFFFFF;
            transform: translateY(-1px);
        }

        .btn-microsoft {
            background-color: #ffffff;
            color: #5e5e5e;
            border: 1px solid #8c8c8c;
            padding: 0.6rem;
            font-size: 0.9rem;
            font-weight: 600;
            border-radius: 8px;
            transition: all 0.3s ease;
        }

        .btn-microsoft:hover {
            background-color: #f3f3f3;
            color: #111;
            transform: translateY(-1px);
            border-color: #333;
        }

        .seguridad-icon-bg {
            background-color: #F8F9FA;
            border-radius: 50%;
            padding: 0.7rem;
            display: inline-block;
            box-shadow: 0 3px 8px rgba(0, 0, 0, 0.08);
        }

        .overlay-loader {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(15, 23, 42, 0.90);
            backdrop-filter: blur(5px);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 9999;
            color: white;
        }
    </style></head><body class="d-flex align-items-center justify-content-center min-vh-100 py-3">

    <div class="container d-flex justify-content-center">
        <div class="card login-card p-3 p-md-4">
            <div class="text-center mb-3">
                <div class="seguridad-icon-bg mb-2">
                    <i class="bi bi-shield-lock-fill fs-3" style="color: var(--color-vino);"></i>
                </div>
                <h5 class="fw-bold mb-0" style="color: var(--color-vino);">Help Desk UNEV</h5>
                <p class="small text-muted mb-0" style="font-size: 0.8rem;">Portal de Autenticación Institucional</p>
            </div>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger alert-dismissible fade show text-center py-1 px-2 mb-2 small" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-1"></i> @ViewBag.Error
                    <button type="button" class="btn-close btn-sm p-1" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <!-- Formulario de Login Tradicional -->
            <form asp-action="Index" method="post" id="formLogin" onsubmit="mostrarLoaderValidando(event)">
                @Html.AntiForgeryToken()
                
                <div class="mb-2">
                    <label class="form-label fw-bold small text-muted mb-1" style="font-size: 0.8rem;">Matrícula / Usuario</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-person"></i></span>
                        <input type="text" name="matricula" class="form-control" placeholder="Ej. 2024-3300026" required autofocus />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold small text-muted mb-1" style="font-size: 0.8rem;">Contraseña</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-key"></i></span>
                        <input type="password" name="contrasena" class="form-control" placeholder="••••••••" required />
                    </div>
                </div>

                <button type="submit" class="btn btn-institucional w-100 fw-bold shadow-sm">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Iniciar Sesión
                </button>
            </form>

            <!-- Divisor visual -->
            <div class="position-relative text-center my-3">
                <hr class="text-muted my-0">
                <span class="position-absolute top-50 start-50 translate-middle px-2 bg-white text-muted" style="font-size: 0.75rem;">o acceso institucional</span>
            </div>

            <!-- Botón de Inicio de Sesión con Microsoft -->
            <div class="d-grid">
                <a asp-action="ExternalLogin" asp-route-provider="Microsoft" class="btn btn-microsoft shadow-sm d-flex align-items-center justify-content-center">
                    <svg class="me-2" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 21 21">
                        <rect x="1" y="1" width="9" height="9" fill="#f25022"/>
                        <rect x="1" y="11" width="9" height="9" fill="#00a4ef"/>
                        <rect x="11" y="1" width="9" height="9" fill="#7fba00"/>
                        <rect x="11" y="11" width="9" height="9" fill="#ffb900"/>
                    </svg>
                    <span>Iniciar sesión con Microsoft</span>
                </a>
            </div>

            <div class="text-center mt-3">
                <small class="text-muted" style="font-size: 0.75rem;">Universidad Nacional Evangélica &copy; 2026</small>
            </div>
        </div>
    </div>

    <!-- Pantalla de Carga: Validando Token y Rol -->
    <div id="loaderOverlay" class="overlay-loader">
        <div class="text-center p-4 rounded-4 shadow-lg border border-secondary" style="background-color: #212529; max-width: 320px; width: 90%;">
            <div class="spinner-border text-light mb-3" style="width: 2.5rem; height: 2.5rem;" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <h6 class="fw-bold mb-2" id="loaderTitle" style="color: #D4AF37;">Validando Token...</h6>
            <p class="small text-light mb-3" id="loaderStatus" style="font-size: 0.8rem;">Verificando firma de seguridad...</p>
            
            <div class="progress" style="height: 5px; background-color: rgba(255,255,255,0.1);">
                <div id="progressBar" class="progress-bar progress-bar-striped progress-bar-animated bg-success" role="progressbar" style="width: 20%;"></div>
            </div>
            
            <div class="mt-3">
                <span class="badge bg-dark border border-secondary" style="font-size: 0.7rem;">
                    <i class="bi bi-shield-check me-1"></i> Protocolo de Seguridad Activo
                </span>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function mostrarLoaderValidando(event) {
            event.preventDefault();

            const overlay = document.getElementById('loaderOverlay');
            const loaderTitle = document.getElementById('loaderTitle');
            const loaderStatus = document.getElementById('loaderStatus');
            const progressBar = document.getElementById('progressBar');
            const form = document.getElementById('formLogin');

            overlay.style.display = 'flex';

            setTimeout(() => {
                loaderTitle.innerText = "Autorizando Token...";
                loaderStatus.innerText = "Confirmando validez de firma criptográfica...";
                progressBar.style.width = "55%";
            }, 400);

            setTimeout(() => {
                loaderTitle.innerText = "Identificando Rol...";
                loaderStatus.innerText = "Determinando permisos institucionales...";
                progressBar.style.width = "85%";
            }, 800);

            setTimeout(() => {
                progressBar.style.width = "100%";
                form.submit();
            }, 1100);
        }
    </script></body></html>